{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 30,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/jarvis",
        "pulseaudio",
        "cpu",
        "memory",
        "tray"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{name}"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d %B, %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "custom/jarvis": {
        "format": "{}",
        "return-type": "json",
        "interval": 1,
        "exec": "cat /tmp/jarvis_status.json 2>/dev/null || echo '{\"text\": \"\", \"class\": \"idle\", \"tooltip\": \"Jarvis Offline\"}'",
        "on-click": "/home/martins/SAAS/Arch.Jarvis/arch_jarvis/scripts/control_jarvis.sh",
        "signal": 8
   },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  Mute",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": "  {}%"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    }
}
